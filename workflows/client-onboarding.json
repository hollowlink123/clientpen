    {
      "parameters": {
        "sendTo": "={{ $json.client_email }}",
        "subject": "=Welcome to the project, {{ $json.client_name }}! Here is what happens next",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:40px;color:#111111\"><p style=\"font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#16a34a;margin-bottom:20px\">PROJECT CONFIRMED</p><h1 style=\"font-size:24px;font-weight:600;margin-bottom:24px\">Welcome! So excited to work with you.</h1><p style=\"margin-bottom:20px\">Hi <strong>' + $(' Format Data').first().json.client_name + '</strong>,</p><p style=\"margin-bottom:20px;color:#555555\">Thank you for choosing to work with me on your <strong>' + $(' Format Data').first().json.project_type + '</strong> project. I am excited to get started and deliver something you will love.</p><table style=\"width:100%;border-collapse:collapse;margin-bottom:32px\"><tr style=\"border-bottom:1px solid #eeeeee\"><td style=\"padding:12px 0;color:#999999;font-size:14px\">Project</td><td style=\"padding:12px 0;font-weight:600;text-align:right\">' + $(' Format Data').first().json.project_type + '</td></tr><tr style=\"border-bottom:1px solid #eeeeee\"><td style=\"padding:12px 0;color:#999999;font-size:14px\">Budget</td><td style=\"padding:12px 0;font-weight:600;text-align:right\">' + $(' Format Data').first().json.budget + '</td></tr><tr><td style=\"padding:12px 0;color:#999999;font-size:14px\">Deadline</td><td style=\"padding:12px 0;font-weight:600;text-align:right\">' + $(' Format Data').first().json.deadline + '</td></tr></table><p style=\"margin-bottom:16px;color:#555555\">Here is what happens next:</p><div style=\"background:#f8f8f8;border-radius:8px;padding:20px;margin-bottom:28px\"><p style=\"margin-bottom:10px\">Step 1. You will receive a short questionnaire to help me understand your vision</p><p style=\"margin-bottom:10px\">Step 2. I will review your answers and begin work on your project</p><p style=\"margin-bottom:10px\">Step 3. I will send you updates as the project progresses</p><p style=\"margin-bottom:0\">Step 4. Final delivery and your feedback</p></div><p style=\"margin-bottom:8px\">If you have any questions at any point just reply to this email.</p><p>Looking forward to working with you!</p><p style=\"margin-top:24px\">Best regards,<br><strong>' + $(' Format Data').first().json.freelancer_name + '</strong></p></div>' }}",
        "options": {
          "appendAttribution": false
        }
      },
