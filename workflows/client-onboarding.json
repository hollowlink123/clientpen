        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:40px;color:#111111\">' +\n'<p style=\"font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#4f46e5;margin-bottom:20px\">PROJECT BRIEF</p>' +\n'<h1 style=\"font-size:22px;font-weight:600;margin-bottom:20px\">Help me understand your vision</h1>' +\n'<p style=\"margin-bottom:16px\">Hi <strong>' + $(' Format Data').first().json.client_name + '</strong>,</p>' +\n'<p style=\"margin-bottom:24px;color:#555555\">To deliver the best possible work I need to understand your goals, preferences and expectations. Please take 5 minutes to answer these questions and reply directly to this email.</p>' +\n'<p style=\"margin-bottom:12px\">1. What is the main goal of this project?</p>' +\n'<p style=\"margin-bottom:12px\">2. Who is your target audience?</p>' +\n'<p style=\"margin-bottom:12px\">3. What brands or styles do you like and why?</p>' +\n'<p style=\"margin-bottom:12px\">4. What makes your business unique?</p>' +\n'<p style=\"margin-bottom:12px\">5. Are there any colors, styles or elements you want to avoid?</p>' +\n'<p style=\"margin-bottom:24px\">6. Any other details I should know?</p>' +\n'<p style=\"margin-bottom:8px;color:#555555\">Simply reply to this email with your answers, no special format needed.</p>' +\n'<p style=\"margin-bottom:24px\">Thank you!</p>' +\n'<p>Best regards,<br><strong>' + $(' Format Data').first().json.freelancer_name + '</strong></p>' +\n'</div>' }}",
