      "parameters": {
        "sendTo": "={{ $json.client_email }}",
        "subject": "=It was a pleasure working with you, {{ $json.client_name }} - one small favour?",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:40px;color:#111111\"><p style=\"font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#999999;margin-bottom:20px\">PROJECT COMPLETE</p><h1 style=\"font-size:24px;font-weight:600;margin-bottom:24px\">Thank you for working with me!</h1><p style=\"margin-bottom:20px\">Hi <strong>' + $('Format Testimonial Data').first().json.client_name + '</strong>,</p><p style=\"margin-bottom:20px;color:#555555\">It was a genuine pleasure working with you on the <strong>' + $('Format Testimonial Data').first().json.project_name + '</strong> project. I hope you are thrilled with the results and that it makes a real difference for your business.</p><p style=\"margin-bottom:16px;color:#555555\">I have one small favour to ask. Would you be willing to share a few words about your experience working with me? It takes less than 2 minutes and helps me show future clients what working together is like.</p><p style=\"margin-bottom:28px;color:#555555\">With your permission, I may share your response on my website or portfolio. Just let me know if you would rather keep it private.</p><div style=\"background:#f8f8f8;border-radius:8px;padding:20px;margin-bottom:28px;border-left:3px solid #111111\"><p style=\"margin-bottom:16px;font-weight:700\">Simply reply to this email with your answers:</p><p style=\"margin-bottom:12px;color:#555555\">1. What did you like most about working together?</p><p style=\"margin-bottom:12px;color:#555555\">2. What results have you seen from the project?</p><p style=\"margin-bottom:0;color:#555555\">3. Would you recommend me to others? (Yes/No and why)</p></div><p style=\"margin-bottom:8px\">Thank you so much for your trust and collaboration.</p><p>Warm regards,<br><strong>' + $('Format Testimonial Data').first().json.freelancer_name + '</strong></p></div>' }}",
        "options": {
          "appendAttribution": false
        }
      },
