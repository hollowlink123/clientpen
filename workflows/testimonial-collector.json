        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    freelancer_name: b.freelancer_name || '',\n    freelancer_email: b.freelancer_email || '',\n    client_name: b.client_name || '',\n    client_email: b.client_email || '',\n    project_name: b.project_name || '',\n    project_type: b.project_type || '',\n    testimonial_link: b.testimonial_link || '',\n    request_date: new Date().toLocaleDateString('en-US', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric'\n    })\n  }\n}];"
